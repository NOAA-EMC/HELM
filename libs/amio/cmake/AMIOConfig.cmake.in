@PACKAGE_INIT@

####################################################################
# AMIOConfig.cmake
#
# Provides imported targets for downstream consumers:
#
#   AMIO::public_headers   - INTERFACE target; C99-only include path.
#   AMIO::amio_core        - SHARED libamio.so; the FFI runtime.
#   AMIO::amio_fortran     - STATIC Fortran iso_c_binding wrapper.
#
# Consumers should write:
#
#   find_package(AMIO REQUIRED)
#   target_link_libraries(my_app PRIVATE AMIO::amio_core)
#
# and need not specify any include path, link path, or compile flag
# manually (R13.1).  Backend driver targets (driver_netcdf,
# driver_zarr, driver_grib2) are PRIVATE to libamio and are NOT
# exposed by this config (R4.8, R13.6).
####################################################################

include(CMakeFindDependencyMacro)

# AMIO's implementation dependencies remain private at compile time, but
# consumers of the shared library need their imported link/runtime targets.
find_dependency(CONF REQUIRED)
find_dependency(HALO REQUIRED)
find_dependency(LOGS REQUIRED)
find_dependency(netCDF CONFIG REQUIRED)
if("@MPI_CXX_FOUND@" STREQUAL "TRUE")
    find_dependency(MPI COMPONENTS CXX)
endif()
if("@g2c_FOUND@" STREQUAL "TRUE")
    find_dependency(g2c CONFIG)
endif()
if(NOT "@AMIO_MEMORY_BACKEND_TARGET@" STREQUAL "")
    find_dependency(Kokkos CONFIG)
endif()
if("@AMIO_HAS_TENSORSTORE@" STREQUAL "TRUE")
    find_dependency(TensorStore CONFIG)
endif()

include("${CMAKE_CURRENT_LIST_DIR}/AMIOTargets.cmake")

check_required_components(AMIO)
