# ============================================================
# HELM Project .gitignore
# C++20 / Fortran / CMake / Kokkos ecosystem
# ============================================================

# ---------- Compiled objects & binaries ----------
*.o
*.obj
*.lo
*.a
*.la
*.lib
*.so
*.so.*
*.dylib
*.dll
*.exe
*.out
*.mod          # Fortran module files
*.smod         # Fortran submodule files

# ---------- Precompiled headers ----------
*.gch
*.pch

# ---------- CMake ----------
build/
_build/
cmake-build-*/
build-ci/
CMakeFiles/
CMakeCache.txt
cmake_install.cmake
CTestTestfile.cmake
Makefile
install_manifest.txt
compile_commands.json
CPackConfig.cmake
CPackSourceConfig.cmake
*.cmake.in~
Testing/

# ---------- IDE & Editors ----------
.vscode/
.idea/
*.swp
*.swo
.sw[a-p]
*~
.DS_Store
Thumbs.db
*.sublime-project
*.sublime-workspace
.project
.cproject
.settings/

# ---------- Kokkos ----------
*.kokkos_*
KokkosCore_config.h

# ---------- Debug / profiling ----------
*.dSYM/
*.su
*.idb
*.pdb
core
core.*
vgcore.*
*.gcda
*.gcno
*.gcov

# ---------- Dependency artifacts ----------
_deps/
external/
third_party/build/
vcpkg_installed/

# ---------- Documentation build ----------
docs/_build/
docs/site/site/
site/
doxygen_output/
html/
latex/

# ---------- Python (if any helper scripts) ----------
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
env/
uv.lock
*.pyi

# ---------- Docker ----------
*.log

# ---------- Testing artifacts ----------
*.xml
Testing/
LastTest.log
LastTestsFailed.log

# ---------- OS junk ----------
.DS_Store
.Spotlight-V100
.Trashes
ehthumbs.db
Desktop.ini

# ---------- Misc ----------
*.bak
*.tmp
*.temp
*.orig
*.rej

# ---------- AMIO development artifacts ----------
*.kate-swp
*.ninja
.ninja_deps
.ninja_log
libs/amio/build-*/
libs/amio/docs/xml/
!libs/amio/docs/site/
!libs/amio/docs/site/api/
libs/amio/docs/site/api/*.md
!libs/amio/docs/site/api/README.md
libs/amio/docs/_build/
libs/amio/docs/html/
package-lock.json
.pre-commit-cache/
coverage/
lcov.info
.spack-env/
spack-lock.yaml
.docker/

# ---------- Local agent state (Kiro specs/steering, superpowers plans/specs) ----------
.kiro/
docs/superpowers/
.specify/
specs/
.github/agents/
.github/prompts/
